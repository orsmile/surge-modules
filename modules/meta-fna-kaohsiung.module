#!name=Meta 圖片影片改走 HiNet 高雄快取（中華電信網路）
#!desc=中華電信用戶看 FB、IG、Threads 很慢時，常是 HiNet 台北的 Meta 快取慢。這個模組在每次切換網路時向 ipinfo.io 查詢目前網路是否為 HiNet（AS3462），是的話才把圖片影片網址改寫到 HiNet 高雄快取（fkhh1-1），並擋掉這些網域的 QUIC 讓 App 改走 TCP；其他網路照常直連。需要 MITM；若大量破圖代表 App 綁定憑證，請停用。
#!homepage=https://github.com/orsmile/surge-modules

[Rule]
# Matches QUIC to Meta's CDN only while on HiNet, so the apps fall back to TCP there
SCRIPT,meta-fna-quic,REJECT-NO-DROP

[Script]
meta-fna-quic = type=rule,script-path=https://orsmile.github.io/surge-modules/scripts/meta-fna-kaohsiung.js,argument=rule,engine=jsc
[Meta 高雄快取] 偵測網路 = type=event,event-name=network-changed,script-path=https://orsmile.github.io/surge-modules/scripts/meta-fna-kaohsiung.js,timeout=30
[Meta 高雄快取] 啟動偵測 = type=event,event-name=engine-started,script-path=https://orsmile.github.io/surge-modules/scripts/meta-fna-kaohsiung.js,timeout=30
[Meta 高雄快取] 改寫 = type=http-request,pattern=^https:\/\/((video|scontent|instagram)-hkg\d+-\d+\.(xx\.fbcdn\.net|cdninstagram\.com)|(video|scontent|instagram)\.ftpe[78]-\d\.fna\.fbcdn\.net)\/,script-path=https://orsmile.github.io/surge-modules/scripts/meta-fna-kaohsiung.js,timeout=5

[MITM]
hostname = %APPEND% *.xx.fbcdn.net, *.cdninstagram.com, *.ftpe7-*.fna.fbcdn.net, *.ftpe8-*.fna.fbcdn.net
